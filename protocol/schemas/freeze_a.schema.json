{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NebulaBunny FREEZE-A package schema",
  "type": "object",
  "required": [
    "proto_version",
    "package_type",
    "metadata",
    "manifest",
    "hashes"
  ],
  "properties": {
    "proto_version": {
      "type": "string",
      "description": "Protocol version of this FREEZE-A package, e.g. '1.0.0'."
    },
    "package_type": {
      "type": "string",
      "const": "FREEZE_A",
      "description": "Must be 'FREEZE_A' for this schema."
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "five_fingerprint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Opaque identifier of this FREEZE-A package."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what this package represents."
        },
        "universe": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of symbols or instruments covered by this package."
        },
        "time_range": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "description": "Start of the backtest or data window (ISO-8601 string)."
            },
            "end": {
              "type": "string",
              "description": "End of the backtest or data window (ISO-8601 string)."
            }
          },
          "additionalProperties": false,
          "description": "Time window of the underlying run or dataset."
        },
        "five_fingerprint": {
          "$ref": "five_fingerprint.schema.json#",
          "description": "Deterministic fingerprint of code, data, spec, seed and environment."
        }
      },
      "additionalProperties": true
    },
    "manifest": {
      "type": "object",
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "role"
            ],
            "properties": {
              "path": {
                "type": "string",
                "description": "Relative path of the file inside the package."
              },
              "role": {
                "type": "string",
                "description": "Logical role of this file, e.g. 'result', 'config', 'evidence'."
              },
              "hash_key": {
                "type": "string",
                "description": "Key into the hashes map for this file."
              }
            },
            "additionalProperties": true
          },
          "description": "Manifest of files included in the FREEZE-A package."
        }
      },
      "additionalProperties": true
    },
    "hashes": {
      "type": "object",
      "description": "Map from hash key or path to its digest.",
      "patternProperties": {
        ".*": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "description": "Hash algorithm used, e.g. 'sha256'."
            },
            "value": {
              "type": "string",
              "description": "Hex-encoded hash value."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "description": "Optional evidence bundle: signatures, cosign attestations, etc.",
      "additionalProperties": true
    },
    "ots": {
      "type": "object",
      "description": "Optional OpenTimestamps-related metadata.",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
